# Enhanced Chicken Counter - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================== API KEYS ====================
# OpenRouter API Key for AI analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Custom OpenAI API Key (if you prefer direct OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# ==================== MODEL SETTINGS ====================
# Default YOLO model to use
DEFAULT_MODEL=yolov8n.pt

# Model confidence threshold (0.0-1.0)
MODEL_CONFIDENCE=0.25

# Non-Maximum Suppression threshold
NMS_THRESHOLD=0.45

# ==================== SYSTEM SETTINGS ====================
# Input source (0 for webcam, path for video file)
INPUT_SOURCE=0

# Output directory for logs and results
OUTPUT_DIR=./logs

# Enable GPU acceleration (true/false)
USE_GPU=true

# Maximum number of chickens to track simultaneously
MAX_TRACKED_OBJECTS=100

# ==================== TRACKING SETTINGS ====================
# ByteTrack tracking buffer size (frames)
TRACK_BUFFER=30

# High confidence threshold for tracking
TRACK_HIGH_THRESH=0.25

# Low confidence threshold for recovery
TRACK_LOW_THRESH=0.1

# Matching threshold for tracking
MATCH_THRESH=0.8

# ==================== LOGGING SETTINGS ====================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable detailed performance logging
PERFORMANCE_LOGGING=true

# Save detection images
SAVE_IMAGES=false

# ==================== AI ANALYSIS SETTINGS ====================
# Enable OpenRouter AI analysis
ENABLE_AI_ANALYSIS=true

# AI analysis model to use
AI_MODEL=anthropic/claude-3-haiku

# Analysis interval (seconds)
AI_ANALYSIS_INTERVAL=30

# ==================== DISPLAY SETTINGS ====================
# Show video output window
SHOW_VIDEO=true

# Video window width
WINDOW_WIDTH=1280

# Video window height  
WINDOW_HEIGHT=720

# Show FPS counter
SHOW_FPS=true

# Show confidence scores
SHOW_CONFIDENCE=true