# ==================== PROJECT SPECIFIC ====================
# Environment files (keep .env.example)
.env
.env.local
.env.production
.env.staging
.env.development

# API keys and secrets
secrets/
*.key
*.pem
*.crt
*.csr

# Configuration files with sensitive data
config/local_*
config/production_*
*_local.json
*_production.json

# Test videos and images
test_video.mp4
test_*.mp4
demo_*.mp4
sample_*.jpg
sample_*.png

# Temporary model downloads
models/cache/
models/temp/
.cache/
.tmp/

# User-specific files
user_settings.json
personal_config.json

# Backup files
*.bak
*.backup
*.old
*.orig

# Compressed files
*.zip
*.tar.gz
*.rar
*.7z

# ==================== DOCKER ====================
# Docker
Dockerfile.local
docker-compose.override.yml
.dockerignore

# ==================== CI/CD ====================
# GitHub Actions (keep main workflows)
.github/workflows/local_*

# ==================== DOCUMENTATION ====================
# Built documentation
docs/build/
docs/_build/
site/

# Temporary markdown files
*.tmp.md

# ==================== SPECIAL CASES ====================
# Keep empty directories with .gitkeep
!.gitkeep

# Keep specific example files
!.env.example
!config/settings.json
!config/model_config.json

# Keep essential model files if they're small
!models/yolov8n.pt

# Keep test data that's under version control
!tests/fixtures/
!examples/sample_*

# Ignore but track empty log directories
logs/*
!logs/.gitkeep
!logs/data/.gitkeep
!logs/performance/.gitkeep
!logs/analysis/.gitkeep
!logs/exports/.gitkeep